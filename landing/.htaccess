<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Counted download link → 302 to GitHub. Writing the row happens here, on
    # the server, so the browser never posts to the API.
    RewriteRule ^download/?$ download.php [QSA,L]

    # Read-only counter value. The rest of the API stays on its own vhost, so
    # the landing origin never exposes admin or auth endpoints.
    RewriteRule ^api/downloads$ api-proxy.php [QSA,L]

    # Pretty /ru → /ru/ for the Russian crawlable mirror.
    RewriteRule ^ru$ ru/ [R=301,L]
</IfModule>

# Explicit types for SEO files (some shared hosts default oddly).
<IfModule mod_mime.c>
    AddType text/plain .txt
    AddType application/xml .xml
</IfModule>

# counter.php is an include and counter-config.php holds the API token.
<FilesMatch "^counter(-config)?(\.sample)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

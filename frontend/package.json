{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "qa": "npm run lint && npm run typecheck && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {

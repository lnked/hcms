{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check . && npm run lint:css",
    "lint:fix": "eslint . --fix && prettier --write . && npm run lint:css -- --fix",
    "lint:css": "stylelint \"src/**/*.css\" --config stylelint.config.json",
    "typecheck": "tsc -b --pretty false",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "qa": "npm run lint && npm run typecheck && npm run knip && npm run test:coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sugar-high": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}

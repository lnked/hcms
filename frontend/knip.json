{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx!", "vite.config.ts!", "eslint.config.js!", "stylelint.config.json!"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/**/*.test.{ts,tsx}", "src/test/**"],
  "ignoreDependencies": [
    "@react-aria/optimize-locales-plugin",
    "@testing-library/dom",
    "eslint-config-prettier",
    "eslint-plugin-import-x",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "stylelint",
    "stylelint-config-css-modules",
    "stylelint-config-standard",
    "@vitest/coverage-v8"
  ],
  "exclude": ["types", "nsExports", "nsTypes", "enumMembers", "namespaceMembers", "duplicates"]
}

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hcms
DB_USERNAME=root
DB_PASSWORD=

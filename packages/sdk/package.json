{
  "name": "@hcms/sdk",
  "version": "0.1.0",
  "description": "Thin HCMS public API client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "types": "node ./bin/hcms-types.mjs"
  },
  "bin": {
    "hcms-types": "./bin/hcms-types.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

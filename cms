#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cms\Backup\BackupHttpClient;
use Cms\Backup\BackupRemoteSettings;
use Cms\Backup\DataBackupService;
use Cms\Backup\RemoteDriverFactory;
use Cms\Core\Config;
use Cms\Core\Env;
use Cms\Core\FileCache;
use Cms\Core\MetadataCache;
use Cms\Core\Paths;
use Cms\Core\Settings;
use Cms\Core\Version;
use Cms\Database\Connection;
use Cms\Database\MigrationService;
use Cms\Database\SchemaDiff;
use Cms\Fields\FieldRepository;
use Cms\Fields\FieldTypeRegistry;
use Cms\Fields\SqlTypeMapper;
use Cms\Resources\ResourceRepository;
use Cms\Uptime\UptimeCheckRepository;
use Cms\Uptime\UptimeIncidentRepository;
use Cms\Uptime\UptimeProbeService;
use Cms\Uptime\UptimeSettings;
use Cms\Uptime\UptimeTargetRepository;

$root = __DIR__;
require $root . '/vendor/autoload.php';

$argv = $_SERVER['argv'] ?? [];
array_shift($argv);
$command = $argv[0] ?? null;
/** @var list<string> $cliArgs */
$cliArgs = array_values(array_map(static fn (mixed $v): string => (string) $v, array_slice($argv, 1)));
$options = parseCliOptions($cliArgs);

$paths = new Paths($root);
$env = new Env();
$env->load($paths->envFile());
$config = Config::fromEnv($env);
$installed = is_file($paths->installedLock());

try {
    match ($command) {
        'status' => cliStatus($paths, $config, $installed),
        'cache:clear' => cliCacheClear($paths),
        'migrate' => cliMigrate($paths, $config, $installed, $options),
        'uptime:check' => cliUptimeCheck($paths, $config, $installed),
        'backup:create' => cliBackupCreate($paths, $config, $installed, $options),
        'backup:list' => cliBackupList($paths, $config, $installed),
        'backup:restore' => cliBackupRestore($paths, $config, $installed, $options),
        'backup:push' => cliBackupPush($paths, $config, $installed, $options),
        null, '', 'help', '--help', '-h' => cliHelp(),
        default => throw new RuntimeException('Unknown command: ' . $command),
    };
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}

exit(0);

/**
 * @param list<string> $args
 * @return array<string, string|bool>
 */
function parseCliOptions(array $args): array
{
    $out = [];
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--') && str_contains($arg, '=')) {
            [$key, $value] = explode('=', substr($arg, 2), 2);
            $out[$key] = $value;
            continue;
        }
        if (str_starts_with($arg, '--')) {
            $out[substr($arg, 2)] = true;
        }
    }

    return $out;
}

function cliHelp(): void
{
    echo <<<TXT
HCMS CLI

Usage:
  php cms status
  php cms migrate [--resource=ID]
  php cms cache:clear
  php cms uptime:check
  php cms backup:create [--push=google,yandex,dropbox,sftp]
  php cms backup:list
  php cms backup:restore --id=data-... --confirm
  php cms backup:push --id=data-... --to=google|yandex|dropbox|sftp

TXT;
}

function cliStatus(Paths $paths, Config $config, bool $installed): void
{
    $resourceCount = 0;
    if ($installed && $config->dbName !== '') {
        $db = cliDb($config);
        $row = $db->selectOne('SELECT COUNT(*) AS c FROM cms_resources');
        $resourceCount = $row === null ? 0 : (int) $row['c'];
    }

    echo 'version: ' . Version::current() . PHP_EOL;
    echo 'installed: ' . ($installed ? 'yes' : 'no') . PHP_EOL;
    echo 'publicDir: ' . $paths->publicDir . PHP_EOL;
    echo 'resources: ' . $resourceCount . PHP_EOL;
}

function cliCacheClear(Paths $paths): void
{
    $cache = new MetadataCache(new FileCache($paths->cache()));
    $cache->flush();
    echo 'Cache cleared.' . PHP_EOL;
}

/**
 * @param array<string, string|bool> $options
 */
function cliMigrate(Paths $paths, Config $config, bool $installed, array $options): void
{
    if (!$installed || $config->dbName === '') {
        throw new RuntimeException('CMS is not installed');
    }

    $db = cliDb($config);
    $resources = new ResourceRepository($db);
    $service = new MigrationService(
        $db,
        $resources,
        new FieldRepository($db),
        new SqlTypeMapper(new FieldTypeRegistry()),
        new SchemaDiff(),
        new MetadataCache(new FileCache($paths->cache())),
    );

    $resourceId = isset($options['resource']) ? (int) $options['resource'] : 0;
    if ($resourceId > 0) {
        $result = $service->applyForResource($resourceId, [
            'confirmDestructive' => !empty($options['confirm-destructive']),
        ]);
        echo 'Migrated resource #' . $resourceId
            . ' → ' . $result['table']
            . ' v' . $result['version']
            . ' (' . count($result['operations']) . ' ops)' . PHP_EOL;

        return;
    }

    $count = 0;
    foreach ($resources->all() as $resource) {
        if (($resource['status'] ?? '') !== 'published') {
            continue;
        }
        $id = (int) $resource['id'];
        $result = $service->applyForResource($id, [
            'confirmDestructive' => !empty($options['confirm-destructive']),
        ]);
        echo 'Migrated #' . $id . ' (' . $resource['slug'] . ') → v' . $result['version'] . PHP_EOL;
        ++$count;
    }

    if ($count === 0) {
        echo 'No published resources to migrate.' . PHP_EOL;
    } else {
        echo 'Done: ' . $count . ' resource(s).' . PHP_EOL;
    }
}

function cliDb(Config $config): Connection
{
    return Connection::connect([
        'host' => $config->dbHost,
        'port' => $config->dbPort,
        'database' => $config->dbName,
        'username' => $config->dbUser,
        'password' => $config->dbPassword,
        'charset' => $config->dbCharset,
    ]);
}

function cliUptimeCheck(Paths $paths, Config $config, bool $installed): void
{
    unset($paths);
    if (!$installed || $config->dbName === '') {
        throw new RuntimeException('CMS is not installed');
    }

    $db = cliDb($config);
    $settings = new Settings($db);
    $targets = new UptimeTargetRepository($db);
    $checks = new UptimeCheckRepository($db);
    $incidents = new UptimeIncidentRepository($db);
    $uptimeSettings = new UptimeSettings($settings);
    $healthUrl = $config->adminBase->healthUrl($config->appUrl);
    $targets->ensureSelf($healthUrl);

    $probe = new UptimeProbeService($targets, $checks, $incidents, $uptimeSettings);
    $results = $probe->runDue();
    if ($results === []) {
        echo 'No due uptime targets.' . PHP_EOL;

        return;
    }

    foreach ($results as $result) {
        $status = !empty($result['ok']) ? 'ok' : 'fail';
        $latency = isset($result['latencyMs']) ? (string) $result['latencyMs'] . 'ms' : 'n/a';
        $name = (string) ($result['name'] ?? '');
        $error = isset($result['error']) && is_string($result['error']) && $result['error'] !== ''
            ? ' — ' . $result['error']
            : '';
        echo $status . "\t" . $name . "\t" . $latency . $error . PHP_EOL;
    }
    echo 'Checked: ' . count($results) . PHP_EOL;
}

function cliBackupService(Paths $paths, Config $config): DataBackupService
{
    $db = cliDb($config);
    $settings = new BackupRemoteSettings(new Settings($db));
    $drivers = new RemoteDriverFactory($settings, new BackupHttpClient(120), $paths);

    return new DataBackupService($paths, $db, $settings, $drivers);
}

/**
 * @param array<string, string|bool> $options
 */
function cliBackupCreate(Paths $paths, Config $config, bool $installed, array $options): void
{
    if (!$installed || $config->dbName === '') {
        throw new RuntimeException('CMS is not installed');
    }
    $pushTo = [];
    if (isset($options['push']) && is_string($options['push']) && $options['push'] !== '') {
        foreach (explode(',', $options['push']) as $p) {
            $p = strtolower(trim($p));
            if ($p !== '') {
                $pushTo[] = $p;
            }
        }
    }
    $result = cliBackupService($paths, $config)->create($pushTo);
    echo 'Backup created: ' . $result['id'] . PHP_EOL;
    if ($result['destinations'] !== []) {
        echo 'Pushed: ' . implode(', ', $result['destinations']) . PHP_EOL;
    }
    if ($result['pushErrors'] !== []) {
        foreach ($result['pushErrors'] as $provider => $message) {
            echo 'Push error (' . $provider . '): ' . $message . PHP_EOL;
        }
    }
}

function cliBackupList(Paths $paths, Config $config, bool $installed): void
{
    if (!$installed || $config->dbName === '') {
        throw new RuntimeException('CMS is not installed');
    }
    $items = cliBackupService($paths, $config)->list();
    if ($items === []) {
        echo 'No data backups.' . PHP_EOL;

        return;
    }
    foreach ($items as $item) {
        $dest = is_array($item['destinations'] ?? null) ? implode(',', $item['destinations']) : '';
        echo ($item['id'] ?? '') . "\t" . ($item['createdAt'] ?? '') . "\t" . ($item['sizeBytes'] ?? 0) . "\t" . $dest . PHP_EOL;
    }
}

/**
 * @param array<string, string|bool> $options
 */
function cliBackupRestore(Paths $paths, Config $config, bool $installed, array $options): void
{
    if (!$installed || $config->dbName === '') {
        throw new RuntimeException('CMS is not installed');
    }
    $id = isset($options['id']) && is_string($options['id']) ? $options['id'] : '';
    if ($id === '') {
        throw new RuntimeException('--id=data-... is required');
    }
    $confirm = !empty($options['confirm']);
    $result = cliBackupService($paths, $config)->restore($id, $confirm);
    echo 'Restored: ' . $result['id'] . ' (safety: ' . $result['safetyBackup'] . ')' . PHP_EOL;
}

/**
 * @param array<string, string|bool> $options
 */
function cliBackupPush(Paths $paths, Config $config, bool $installed, array $options): void
{
    if (!$installed || $config->dbName === '') {
        throw new RuntimeException('CMS is not installed');
    }
    $id = isset($options['id']) && is_string($options['id']) ? $options['id'] : '';
    $to = isset($options['to']) && is_string($options['to']) ? $options['to'] : '';
    if ($id === '' || $to === '') {
        throw new RuntimeException('--id= and --to= are required');
    }
    $result = cliBackupService($paths, $config)->push($id, $to);
    echo 'Pushed ' . $result['id'] . ' → ' . $result['provider'] . PHP_EOL;
}
